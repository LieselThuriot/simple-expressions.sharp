{
  "$comment": [
    "Cross-implementation parity corpus for simple-expressions.",
    "This file is the canonical copy and lives in the TypeScript reference repository.",
    "The C# and Dart ports vendor a byte-identical copy; run scripts/sync-parity.js to update them.",
    "",
    "Each case has an id, an expression, an optional model (defaults to {}), and exactly one",
    "expectation:",
    "  value   - the raw result of parseExpression(expression)(model)",
    "  truthy  - the boolean result of executeExpression(model, expression)",
    "  error   - a substring that the thrown message must contain",
    "An optional skip list names implementations that deliberately do not run the case.",
    "Valid skip entries are \"ts\", \"csharp\" and \"dart\"."
  ],
  "cases": [
    {
      "id": "boolean-literals",
      "expression": "true",
      "truthy": true
    },
    {
      "id": "boolean-literals-false",
      "expression": "false",
      "truthy": false
    },
    {
      "id": "case-insensitive-operators",
      "expression": "AND(true, false, true)",
      "truthy": false
    },
    {
      "id": "and-short-circuits",
      "expression": "and(false, len(#value))",
      "model": { "value": {} },
      "truthy": false
    },
    {
      "id": "or-short-circuits",
      "expression": "or(true, len(#value))",
      "model": { "value": {} },
      "truthy": true
    },
    {
      "id": "len-without-length-throws",
      "expression": "len(#value)",
      "model": { "value": {} },
      "error": "Input does not have a length"
    },
    {
      "id": "nested-reference",
      "expression": "eq(#form.address.city, \"Ghent\")",
      "model": { "form": { "address": { "city": "Ghent" } } },
      "truthy": true
    },
    {
      "id": "dotted-key-wins-over-traversal",
      "expression": "#value.child",
      "model": { "value": { "child": "nested" }, "value.child": "direct" },
      "value": "direct"
    },
    {
      "id": "list-literal",
      "expression": "[1, lower(\"YES\"), [true, 2]]",
      "value": [1, "yes", [true, 2]]
    },
    {
      "id": "in-uses-loose-equality",
      "expression": "in(1, [\"1\", 2])",
      "truthy": true
    },
    {
      "id": "in-boolean-number",
      "expression": "in(false, [0, true])",
      "truthy": true
    },
    {
      "id": "eq-number-string",
      "expression": "eq(1, \"1\")",
      "truthy": true
    },
    {
      "id": "eq-boolean-number",
      "expression": "eq(false, 0)",
      "truthy": true
    },
    {
      "id": "concat-skips-falsey",
      "expression": "concat(\"a\", 0, false, #missing, \"b\")",
      "value": "ab"
    },
    {
      "id": "trim-preserves-nullish",
      "expression": "trim(#value)",
      "model": { "value": null },
      "value": null
    },
    {
      "id": "lower-coerces",
      "expression": "lower(123)",
      "value": "123"
    },
    {
      "id": "if-selects-one-branch",
      "expression": "if(false, len(#value), \"no\")",
      "model": { "value": {} },
      "value": "no"
    },
    {
      "id": "match-constant-pattern",
      "expression": "match(#value, \"^hello$\")",
      "model": { "value": "hello" },
      "truthy": true
    },
    {
      "id": "match-runtime-pattern",
      "expression": "match(#value, #pattern)",
      "model": { "value": "hello", "pattern": "^hello$" },
      "truthy": true
    },
    {
      "id": "match-non-string-pattern",
      "expression": "match(#value, #pattern)",
      "model": { "value": "hello", "pattern": 123 },
      "truthy": false
    },
    {
      "id": "numeric-literal-signed",
      "expression": "+12",
      "value": 12
    },
    {
      "id": "numeric-literal-exponent",
      "expression": "-2.5E-2",
      "value": -0.025
    },

    {
      "id": "reject-trailing-input",
      "expression": "eq(1, 2) trailing",
      "error": "unexpected trailing input"
    },
    {
      "id": "reject-unknown-operator",
      "expression": "hello",
      "error": "invalid operator: hello"
    },
    {
      "id": "reject-null-literal",
      "expression": "null",
      "error": "invalid operator: null"
    },
    {
      "id": "reject-unary-with-two-arguments",
      "expression": "not(true, false)",
      "error": "operator not expects one argument"
    },
    {
      "id": "reject-binary-with-one-argument",
      "expression": "eq(1)",
      "error": "operator eq expects two arguments"
    },
    {
      "id": "reject-ternary-with-two-arguments",
      "expression": "if(true, 1)",
      "error": "operator if expects three arguments"
    },
    {
      "id": "reject-variadic-with-one-argument",
      "expression": "concat(\"value\")",
      "error": "operator concat expects at least two arguments"
    },
    {
      "id": "reject-missing-argument",
      "expression": "not()",
      "error": "missing operator argument"
    },
    {
      "id": "reject-unterminated-string",
      "expression": "\"unterminated",
      "error": "unterminated string"
    },
    {
      "id": "reject-unclosed-list",
      "expression": "[1, 2",
      "error": "expected closing bracket"
    },
    {
      "id": "reject-empty-reference",
      "expression": "#",
      "error": "missing model reference"
    },
    {
      "id": "reject-trailing-dot-reference",
      "expression": "#value.",
      "error": "Invalid Expression: invalid model reference: #value."
    },
    {
      "id": "reject-prototype-segment",
      "expression": "#value.constructor",
      "error": "Invalid Expression: invalid model reference: #value.constructor"
    },

    {
      "id": "divergence-nullish-equality",
      "$comment": "Missing and null are equal to each other and to nothing else.",
      "expression": "eq(#missing, #value)",
      "model": { "value": null },
      "truthy": true
    },
    {
      "id": "divergence-nullish-not-equal-to-false",
      "expression": "eq(#value, false)",
      "model": { "value": null },
      "truthy": false
    },
    {
      "id": "divergence-structural-array-equality",
      "$comment": "The ports compare arrays and objects structurally; the reference compares by reference.",
      "expression": "eq(#a, #b)",
      "model": { "a": [1, 2], "b": [1, 2] },
      "truthy": true,
      "skip": ["ts"]
    },
    {
      "id": "divergence-structural-array-inequality",
      "expression": "eq(#a, #b)",
      "model": { "a": [1, 2], "b": [1, 3] },
      "truthy": false
    },
    {
      "id": "divergence-structural-array-length",
      "expression": "eq(#a, #b)",
      "model": { "a": [1, 2], "b": [1, 2, 3] },
      "truthy": false
    },
    {
      "id": "divergence-structural-nested-array-equality",
      "expression": "eq(#a, #b)",
      "model": { "a": [1, [2, 3]], "b": [1, [2, 3]] },
      "truthy": true,
      "skip": ["ts"]
    },
    {
      "id": "divergence-structural-object-equality",
      "expression": "eq(#a, #b)",
      "model": { "a": { "x": 1 }, "b": { "x": 1 } },
      "truthy": true,
      "skip": ["ts"]
    },
    {
      "id": "divergence-structural-object-inequality",
      "expression": "eq(#a, #b)",
      "model": { "a": { "x": 1 }, "b": { "x": 2 } },
      "truthy": false
    },
    {
      "id": "divergence-structural-object-extra-key",
      "expression": "eq(#a, #b)",
      "model": { "a": { "x": 1 }, "b": { "x": 1, "y": 2 } },
      "truthy": false
    },
    {
      "id": "divergence-same-reference-array",
      "expression": "eq(#list, #list)",
      "model": { "list": [1, 2] },
      "truthy": true
    },
    {
      "id": "divergence-empty-string-is-not-zero",
      "$comment": "The ports only convert a string that parses as a number; JavaScript treats \"\" as 0.",
      "expression": "eq(#value, 0)",
      "model": { "value": "" },
      "truthy": false,
      "skip": ["ts"]
    },
    {
      "id": "divergence-blank-string-is-not-zero",
      "expression": "eq(#value, 0)",
      "model": { "value": "   " },
      "truthy": false,
      "skip": ["ts"]
    },
    {
      "id": "divergence-numeric-string-still-converts",
      "expression": "eq(#value, 12)",
      "model": { "value": "12" },
      "truthy": true
    },

    {
      "id": "number-format-small-decimal",
      "$comment": "Plain notation for magnitudes in [1e-6, 1e21).",
      "expression": "concat(#value, \"\")",
      "model": { "value": 0.00001 },
      "value": "0.00001"
    },
    {
      "id": "number-format-large-integer",
      "expression": "concat(#value, \"\")",
      "model": { "value": 1e16 },
      "value": "10000000000000000"
    },
    {
      "id": "number-format-exponent-upper-bound",
      "expression": "concat(#value, \"\")",
      "model": { "value": 1e21 },
      "value": "1e+21"
    },
    {
      "id": "number-format-exponent-lower-bound",
      "expression": "concat(#value, \"\")",
      "model": { "value": 1e-7 },
      "value": "1e-7"
    },
    {
      "id": "number-format-fraction",
      "expression": "concat(#value, \"\")",
      "model": { "value": 12.5 },
      "value": "12.5"
    },
    {
      "id": "number-format-negative-fraction",
      "expression": "concat(#value, \"\")",
      "model": { "value": -0.025 },
      "value": "-0.025"
    },
    {
      "id": "number-format-integral",
      "expression": "concat(#value, \"\")",
      "model": { "value": 5 },
      "value": "5"
    },
    {
      "id": "number-format-array",
      "expression": "concat(#value, \"\")",
      "model": { "value": [1, 2.5] },
      "value": "1,2.5"
    }
  ]
}
